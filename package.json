{
  "name": "@studiometa/ui-workspace",
  "version": "1.9.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test -w @studiometa/ui-tests",
    "test:watch": "npm run test:watch -w @studiometa/ui-tests",
    "cdn:build": "npm run build -w @studiometa/ui-cdn",
    "cdn:test": "npm test -w @studiometa/ui-cdn",
    "cdn:test:build": "npm run test:build -w @studiometa/ui-cdn",
    "cdn:test:worker": "npm run test:worker -w @studiometa/ui-cdn",
    "cdn:test:publication": "npm run test:publication -w @studiometa/ui-cdn",
    "cdn:test:browser": "npm run test:browser -w @studiometa/ui-cdn",
    "cdn:publish": "npm run publish -w @studiometa/ui-cdn",
    "cdn:rollback": "npm run rollback -w @studiometa/ui-cdn",
    "cdn:smoke": "npm run smoke -w @studiometa/ui-cdn",
    "manifest:generate": "node scripts/generate-manifests.ts",
    "manifest:check": "node scripts/generate-manifests.ts --check",
    "build": "rm -rf packages/ui/dist && npm run build:pkg && npm run build:sizes && npm run build:twig && npm run build:cp-files",
    "build:cp-files": "node scripts/build-dist-pkg.js",
    "build:twig": "rsync -avh --exclude='/dist' --include='*/' --include='**/*.twig' --exclude='*' --prune-empty-dirs packages/ui/ packages/ui/dist/",
    "build:pkg": "node scripts/build.js",
    "build:sizes": "node scripts/sizes.js",
    "build:export-size": "npm run build && (if [ -d packages/ui-mapbox ]; then npm run build --workspace=@studiometa/ui-mapbox; fi) && (if [ -d packages/ui-autoload ]; then npm run build --workspace=@studiometa/ui-autoload; fi)",
    "lint": "npm run lint:static && npm run lint:types && npm run lint:prettier",
    "lint:static": "oxlint --tsconfig ./tsconfig.json --type-aware",
    "lint:types": "tsgo --build tsconfig.lint.json",
    "lint:prettier": "prettier --check --cache packages/docs/**/*.md",
    "docs:dev": "npm run dev -w @studiometa/ui-docs",
    "docs:build": "npm run build -w @studiometa/ui-docs",
    "play:dev": "npm run dev -w @studiometa/ui-playground",
    "play:watch": "npm run watch -w @studiometa/ui-playground",
    "play:build": "npm run build -w @studiometa/ui-playground",
    "cdn:test:watch": "npm run test:watch -w @studiometa/ui-cdn",
    "postversion": "npm version --workspaces $npm_package_version && node scripts/update-composer-version.js",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@studiometa/prettier-config": "4.4.0",
    "@typescript/native-preview": "7.0.0-dev.20260325.1",
    "fast-glob": "3.3.3",
    "gzip-size": "7.0.0",
    "oxlint": "1.57.0",
    "oxlint-tsgolint": "0.17.4",
    "prettier": "3.8.1",
    "tsdown": "0.21.5"
  },
  "overrides": {
    "@typescript/vfs": "1.6.4"
  },
  "dependencies": {
    "patch-package": "8.0.1"
  }
}
