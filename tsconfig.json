{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "dom", "ES2015", "ES2016", "ES2017", "ES2018", "ES2019", "ES2020"],
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "#private/*": ["./packages/ui/*"],
      "#test-utils": ["./packages/tests/__utils__/index.ts"],
      "@studiometa/ui-mapbox": ["./packages/ui-mapbox/src/index.ts"],
      "@studiometa/ui-mapbox/*": ["./packages/ui-mapbox/src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "packages/ui/**/*.ts",
    "packages/ui-mapbox/src/**/*.ts",
    "packages/tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
