{
  "name": "@studiometa/ui-cdn",
  "version": "1.10.0-beta.2",
  "description": "Private browser CDN build for @studiometa/ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "vitest run",
    "test:build": "vitest run tests/build.test.ts",
    "test:worker": "vitest run tests/worker",
    "test:publication": "vitest run tests/publication.test.ts tests/worker/observability.test.ts",
    "test:browser": "node scripts/build.ts --allow-dirty && playwright test --config playwright.config.ts",
    "test:watch": "vitest",
    "publish": "node scripts/publish.ts",
    "rollback": "node scripts/rollback.ts",
    "smoke": "node scripts/smoke.ts"
  },
  "author": "Studio Meta <agence@studiometa.fr> (https://www.studiometa.fr/)",
  "license": "MIT",
  "dependencies": {
    "@studiometa/ui": "file:../ui",
    "@studiometa/ui-autoload": "file:../ui-autoload",
    "@studiometa/ui-mapbox": "file:../ui-mapbox"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.738.0",
    "@happy-dom/global-registrator": "^20.8.8",
    "@mapbox/mapbox-gl-geocoder": "5.1.2",
    "@playwright/test": "1.61.1",
    "@studiometa/js-toolkit": "3.8.0",
    "happy-dom": "^20.8.8",
    "mapbox-gl": "3.27.0",
    "tsdown": "0.21.5",
    "vitest": "4.1.1"
  }
}
