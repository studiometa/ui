{
  "name": "@studiometa/ui-mapbox",
  "version": "1.10.0-beta.5",
  "description": "Vanilla js-toolkit components to build Mapbox GL maps declaratively",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./autoload.ts",
    "./autoload.js"
  ],
  "main": "index.ts",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.ts",
    "./autoload": "./autoload.ts",
    "./manifest": "./manifest.ts",
    "./AbstractMapboxControl": "./AbstractMapboxControl.ts",
    "./AbstractMapboxMapChild": "./AbstractMapboxMapChild.ts",
    "./MapboxCluster": "./MapboxCluster.ts",
    "./MapboxClusterItem": "./MapboxClusterItem.ts",
    "./MapboxFullscreenControl": "./MapboxFullscreenControl.ts",
    "./MapboxGeocoder": "./MapboxGeocoder.ts",
    "./MapboxGeolocateControl": "./MapboxGeolocateControl.ts",
    "./MapboxImage": "./MapboxImage.ts",
    "./MapboxImages": "./MapboxImages.ts",
    "./MapboxLayer": "./MapboxLayer.ts",
    "./MapboxMap": "./MapboxMap.ts",
    "./MapboxMarker": "./MapboxMarker.ts",
    "./MapboxNavigationControl": "./MapboxNavigationControl.ts",
    "./MapboxPopup": "./MapboxPopup.ts",
    "./MapboxSource": "./MapboxSource.ts",
    "./StoreLocator": "./StoreLocator.ts",
    "./dependencies": "./dependencies.ts",
    "./*": "./*.ts"
  },
  "scripts": {
    "build": "node scripts/build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiometa/ui.git"
  },
  "keywords": [
    "ui",
    "components",
    "mapbox",
    "mapbox-gl",
    "js-toolkit",
    "map"
  ],
  "author": "Studio Meta <agence@studiometa.fr> (https://www.studiometa.fr/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/studiometa/ui/issues"
  },
  "homepage": "https://github.com/studiometa/ui#readme",
  "peerDependencies": {
    "@mapbox/mapbox-gl-geocoder": "^5.0.0",
    "@studiometa/js-toolkit": "^3.9.0-beta.2",
    "mapbox-gl": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@mapbox/mapbox-gl-geocoder": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mapbox/mapbox-gl-geocoder": "^5.1.0",
    "@studiometa/js-toolkit": "^3.9.0-beta.2",
    "@types/mapbox__mapbox-gl-geocoder": "^5.0.0",
    "mapbox-gl": "^3.13.0",
    "tsdown": "0.21.5"
  }
}
