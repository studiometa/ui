{
  "name": "@studiometa/ui-mapbox",
  "version": "1.10.0-beta.4",
  "description": "Vanilla js-toolkit components to build Mapbox GL maps declaratively",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "index.ts",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.ts",
    "./manifest": "./manifest.ts",
    "./manifest.js": "./manifest.ts",
    "./*.js": "./*.ts",
    "./*": "./*.ts"
  },
  "scripts": {
    "build": "node scripts/build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiometa/ui.git"
  },
  "keywords": [
    "ui",
    "components",
    "mapbox",
    "mapbox-gl",
    "js-toolkit",
    "map"
  ],
  "author": "Studio Meta <agence@studiometa.fr> (https://www.studiometa.fr/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/studiometa/ui/issues"
  },
  "homepage": "https://github.com/studiometa/ui#readme",
  "peerDependencies": {
    "@mapbox/mapbox-gl-geocoder": "^5.0.0",
    "@studiometa/js-toolkit": "^3.8.0",
    "@studiometa/ui-autoload": "^1.9.0",
    "mapbox-gl": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@mapbox/mapbox-gl-geocoder": {
      "optional": true
    },
    "@studiometa/ui-autoload": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mapbox/mapbox-gl-geocoder": "^5.1.0",
    "@studiometa/js-toolkit": "^3.8.0",
    "@studiometa/ui-autoload": "file:../ui-autoload",
    "@types/mapbox__mapbox-gl-geocoder": "^5.0.0",
    "mapbox-gl": "^3.13.0",
    "tsdown": "0.21.5"
  }
}
