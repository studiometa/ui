{
  "name": "@studiometa/ui-mapbox",
  "version": "2.0.0-alpha.0",
  "description": "Vanilla js-toolkit components to build Mapbox GL maps declaratively",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/autoload.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "typescript": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./autoload": {
      "typescript": "./src/autoload.ts",
      "types": "./dist/autoload.d.ts",
      "import": "./dist/autoload.js"
    },
    "./manifest": {
      "typescript": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./AbstractMapboxControl": {
      "typescript": "./src/AbstractMapboxControl.ts",
      "types": "./dist/AbstractMapboxControl.d.ts",
      "import": "./dist/AbstractMapboxControl.js"
    },
    "./AbstractMapboxMapChild": {
      "typescript": "./src/AbstractMapboxMapChild.ts",
      "types": "./dist/AbstractMapboxMapChild.d.ts",
      "import": "./dist/AbstractMapboxMapChild.js"
    },
    "./MapboxCluster": {
      "typescript": "./src/MapboxCluster.ts",
      "types": "./dist/MapboxCluster.d.ts",
      "import": "./dist/MapboxCluster.js"
    },
    "./MapboxClusterItem": {
      "typescript": "./src/MapboxClusterItem.ts",
      "types": "./dist/MapboxClusterItem.d.ts",
      "import": "./dist/MapboxClusterItem.js"
    },
    "./MapboxFullscreenControl": {
      "typescript": "./src/MapboxFullscreenControl.ts",
      "types": "./dist/MapboxFullscreenControl.d.ts",
      "import": "./dist/MapboxFullscreenControl.js"
    },
    "./MapboxGeocoder": {
      "typescript": "./src/MapboxGeocoder.ts",
      "types": "./dist/MapboxGeocoder.d.ts",
      "import": "./dist/MapboxGeocoder.js"
    },
    "./MapboxGeolocateControl": {
      "typescript": "./src/MapboxGeolocateControl.ts",
      "types": "./dist/MapboxGeolocateControl.d.ts",
      "import": "./dist/MapboxGeolocateControl.js"
    },
    "./MapboxImage": {
      "typescript": "./src/MapboxImage.ts",
      "types": "./dist/MapboxImage.d.ts",
      "import": "./dist/MapboxImage.js"
    },
    "./MapboxImages": {
      "typescript": "./src/MapboxImages.ts",
      "types": "./dist/MapboxImages.d.ts",
      "import": "./dist/MapboxImages.js"
    },
    "./MapboxLayer": {
      "typescript": "./src/MapboxLayer.ts",
      "types": "./dist/MapboxLayer.d.ts",
      "import": "./dist/MapboxLayer.js"
    },
    "./MapboxMap": {
      "typescript": "./src/MapboxMap.ts",
      "types": "./dist/MapboxMap.d.ts",
      "import": "./dist/MapboxMap.js"
    },
    "./MapboxMarker": {
      "typescript": "./src/MapboxMarker.ts",
      "types": "./dist/MapboxMarker.d.ts",
      "import": "./dist/MapboxMarker.js"
    },
    "./MapboxNavigationControl": {
      "typescript": "./src/MapboxNavigationControl.ts",
      "types": "./dist/MapboxNavigationControl.d.ts",
      "import": "./dist/MapboxNavigationControl.js"
    },
    "./MapboxPopup": {
      "typescript": "./src/MapboxPopup.ts",
      "types": "./dist/MapboxPopup.d.ts",
      "import": "./dist/MapboxPopup.js"
    },
    "./MapboxSource": {
      "typescript": "./src/MapboxSource.ts",
      "types": "./dist/MapboxSource.d.ts",
      "import": "./dist/MapboxSource.js"
    },
    "./StoreLocator": {
      "typescript": "./src/StoreLocator.ts",
      "types": "./dist/StoreLocator.d.ts",
      "import": "./dist/StoreLocator.js"
    },
    "./dependencies": {
      "typescript": "./src/dependencies.ts",
      "types": "./dist/dependencies.d.ts",
      "import": "./dist/dependencies.js"
    },
    "./*": {
      "typescript": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiometa/ui.git"
  },
  "keywords": [
    "ui",
    "components",
    "mapbox",
    "mapbox-gl",
    "js-toolkit",
    "map"
  ],
  "author": "Studio Meta <agence@studiometa.fr> (https://www.studiometa.fr/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/studiometa/ui/issues"
  },
  "homepage": "https://github.com/studiometa/ui#readme",
  "peerDependencies": {
    "@mapbox/mapbox-gl-geocoder": "^5.0.0",
    "@studiometa/js-toolkit": "^4.0.0-alpha.1",
    "mapbox-gl": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@mapbox/mapbox-gl-geocoder": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mapbox/mapbox-gl-geocoder": "^5.1.0",
    "@studiometa/js-toolkit": "^4.0.0-alpha.1",
    "@types/mapbox__mapbox-gl-geocoder": "^5.0.0",
    "mapbox-gl": "^3.13.0",
    "tsdown": "0.21.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ]
}
