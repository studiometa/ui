{# The steps compose one timeline in DOM order. The badge and the heading
   follow one another, the paragraph starts with the heading (`at: "<"`), and
   the button overlaps the end of the paragraph (`at: "-=0.2"`). One
   `restart()` on the timeline replays the whole choreography. #}
<div class="grid justify-items-start gap-6">
  <section
    id="intro"
    data-component="GsapTimeline"
    data-option-timeline='{ "defaults": { "duration": 0.6, "ease": "power3.out" } }'
    data-option-autoplay
    class="grid justify-items-start gap-3">
    <span
      data-component="GsapStep"
      data-option-from='{ "opacity": 0, "scale": 0.8 }'
      class="rounded-full bg-blue-100 px-3 py-1 text-sm text-blue-900 dark:bg-blue-900 dark:text-blue-100">
      New
    </span>
    <h2
      data-component="GsapStep"
      data-option-from='{ "opacity": 0, "y": 24 }'
      class="text-2xl font-bold">
      A timeline from the markup
    </h2>
    <p
      data-component="GsapStep"
      data-option-from='{ "opacity": 0, "x": -24 }'
      data-option-at="<"
      class="max-w-prose">
      Each step declares one tween, and the timeline places them in DOM order.
    </p>
    <a
      href="#"
      data-component="GsapStep"
      data-option-from='{ "opacity": 0, "y": 12 }'
      data-option-at="-=0.2"
      class="rounded bg-blue-400 px-4 py-2 font-bold text-white dark:bg-blue-600">
      Read more
    </a>
  </section>

  <button
    type="button"
    data-component="Action"
    data-on:click="GsapTimeline(#intro)->target.restart()"
    class="rounded bg-zinc-200 px-4 py-2 dark:bg-zinc-800">
    Replay
  </button>
</div>
