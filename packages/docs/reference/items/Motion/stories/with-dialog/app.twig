<button
  type="button"
  data-component="Action"
  data-on:click="Dialog(#motion-modal)->target.open()"
  class="px-4 py-2 rounded bg-blue-600 text-white font-semibold">
  Open dialog
</button>

{# The <dialog> host carries NO display utility, so its native open/closed
   display (block / none) is preserved. The `open` event plays the box's spring
   entrance and the `close` event plays it in reverse; registering each with
   `detail.waitUntil()` makes the dialog await it, so the exit plays in full
   before the native dialog hides.

   The `?.` is not decoration: <dialog> fires its own native `close` event once
   hidden, with no detail. The optional chain skips it — and skips the
   `reverse()` call with it. #}
<dialog
  id="motion-modal"
  data-component="Action Dialog"
  data-on:open="Motion(#motion-modal-box)->event.detail?.waitUntil(target.play())"
  data-on:close="Motion(#motion-modal-box)->event.detail?.waitUntil(target.reverse())"
  data-on:cancel.prevent="Dialog.close()"
  class="fixed inset-0 m-0 p-0 w-full h-full max-w-none max-h-none bg-transparent overflow-y-auto">
  <div
    data-component="Action"
    data-on:click="Dialog(#motion-modal)->target.close()"
    class="fixed inset-0 bg-black/50"></div>

  <div
    class="pointer-events-none relative flex min-h-full items-center justify-center p-4">
    <div
      id="motion-modal-box"
      data-component="Motion"
      data-option-initial='{ "opacity": 0, "scale": 0.8, "y": 40 }'
      data-option-animate='{ "opacity": 1, "scale": 1, "y": 0 }'
      data-option-transition='{ "type": "spring", "bounce": 0.4 }'
      class="pointer-events-auto relative w-full max-w-lg p-8 rounded-lg bg-white text-black shadow-2xl">
      <h2 class="text-xl font-bold mb-3">Spring entrance and exit</h2>
      <p class="mb-6 text-black/60">
        The <code>Dialog</code> handles the top layer, focus and scroll lock; the
        <code>Motion</code> box springs in on its <code>open</code> event and springs
        back out before the dialog closes, which it waits for — physics a CSS transition
        cannot express.
      </p>
      <button
        type="button"
        data-component="Action"
        data-on:click="Dialog(#motion-modal)->target.close()"
        class="px-4 py-2 rounded bg-gray-900 text-white">
        Close
      </button>
    </div>
  </div>
</dialog>

<style>
  dialog::backdrop { background: transparent; }
</style>
