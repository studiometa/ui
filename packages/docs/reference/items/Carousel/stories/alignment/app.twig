{% set colors = ['red', 'green', 'blue', 'purple'] %}
{% set count = 6 %}

{# The class names are written out rather than built as `snap-{{ value }}`:
   they have to appear literally in the source for the CSS build to find them. #}
{% set alignments = [
  { value: 'start', class: 'snap-start' },
  { value: 'center', class: 'snap-center' },
  { value: 'end', class: 'snap-end' }
] %}

<div class="grid gap-12 p-10">
  {% for alignment in alignments %}
    <div data-component="Carousel"
      aria-label="Slides aligned to {{ alignment.value }}"
      class="grid gap-4">
      <p class="font-mono text-sm text-gray-600">scroll-snap-align: {{ alignment.value }}</p>
      <div data-component="CarouselWrapper"
        class="flex items-center gap-8 w-full overflow-x-auto snap-x snap-mandatory"
        style="scrollbar-width: none;">
        {% for i in 1..count %}
          {% set color = colors[loop.index0 % (colors|length)] %}
          <div data-component="CarouselItem"
            class="
              {{
            alignment.class
            }} shrink-0 flex items-center justify-center
              w-1/2 h-32 bg-{{
            color
            }}-400 ring-inset ring-{{
            color
            }}-600
              ring
              text-white font-bold rounded-xl
            "
            style="--tw-ring-opacity: var(--carousel-item-active, 0)">
            N°{{ i }}
          </div>
        {% endfor %}
      </div>
      <nav class="flex items-center justify-center gap-2">
        {% include '@ui/Button/StyledButton.twig' with {
          label: '← Prev',
          attr: {
            data_component: 'CarouselBtn',
            data_option_action: 'prev'
          }
        } %}
        {% include '@ui/Button/StyledButton.twig' with {
          label: 'Next →',
          attr: {
            data_component: 'CarouselBtn',
            data_option_action: 'next'
          }
        } %}
      </nav>
    </div>
  {% endfor %}
</div>
