{
  "name": "@studiometa/ui-docs",
  "version": "1.11.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently 'npm run dev:playground' 'npm run dev:vitepress' --names 'play,docs'",
    "dev:playground": "npm run watch --workspace=@studiometa/ui-playground",
    "dev:vitepress": "vitepress dev . --host",
    "validate:reference": "node --experimental-strip-types scripts/validate-reference.ts",
    "prebuild": "npm run validate:reference && npm run build --workspace=@studiometa/ui-playground",
    "build": "vitepress build .",
    "postbuild": "ln -sf ../../../api/public .vitepress/dist/api"
  },
  "dependencies": {
    "@studiometa/js-toolkit": "3.9.0"
  },
  "devDependencies": {
    "@iconify-json/octicon": "1.2.40",
    "@shikijs/vitepress-twoslash": "3.23.0",
    "@studiometa/playground-preview": "0.4.0",
    "@studiometa/tailwind-config": "2.1.0",
    "autoprefixer": "10.6.1",
    "concurrently": "9.2.5",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "unplugin-icons": "22.5.0",
    "unplugin-vue-components": "30.0.0",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-llms": "1.14.0"
  }
}
